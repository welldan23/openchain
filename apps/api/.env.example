# Salin file ini menjadi .env lalu sesuaikan. Jangan commit file .env.
# Kredensial di bawah hanya untuk database lokal (docker compose di root repo).
DATABASE_URL=postgres://openchain:openchain@localhost:5432/openchain
PORT=4000

# Snapshot yang lebih tua dari ini (menit) ditandai stale.
SNAPSHOT_STALE_AFTER_MINUTES=60
