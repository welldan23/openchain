# Salin file ini menjadi .env lalu sesuaikan. Jangan commit file .env.
# Kredensial di bawah hanya untuk database lokal (docker compose di root repo).
DATABASE_URL=postgres://openchain:openchain@localhost:5432/openchain
PORT=4000

# Snapshot yang lebih tua dari ini (menit) ditandai stale.
SNAPSHOT_STALE_AFTER_MINUTES=60

# --- Provider data on-chain (semuanya opsional) ---
# Tanpa isian di bawah, adapter memakai RPC publik, instance Blockscout publik,
# dan Dexscreener. Nilai di sini tidak pernah dicetak ke log.
#
# Ganti RPC sebuah chain, mis. dengan RPC berbayar yang memakai API key.
# Beberapa URL dipisah koma; bila yang pertama gagal, pindah ke berikutnya:
# RPC_URL_ROBINHOOD=
# RPC_URL_ETHEREUM=
#
# API key gratis Blockscout PRO API (https://dev.blockscout.com). Disarankan
# untuk Robinhood Chain, karena instance publiknya bisa menolak request
# server dengan proteksi bot.
# BLOCKSCOUT_API_KEY=
#
# Ganti instance Blockscout sebuah chain, mis. untuk chain yang belum punya:
# BLOCKSCOUT_URL_BSC=
#
# Batas waktu tiap request provider dalam milidetik.
# PROVIDER_TIMEOUT_MS=15000
