{
  "name": "openchain",
  "version": "0.1.0",
  "private": true,
  "description": "OpenChain Intelligence — workspace investigasi on-chain multichain.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:api": "npm run start:dev --workspace api",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace web",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "ingest": "npm run ingest --workspace api --",
    "smoke:chain": "npm run smoke:chain --workspace api --"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
